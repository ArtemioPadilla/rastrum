# Megadetector hosting recipe artefacts — large model weights belong in
# cloud storage (R2), not git. The recipe scripts (convert.sh,
# quantize_int8.py, README.md) ARE tracked; their outputs are not.
infra/megadetector/venv/
infra/megadetector/yolov5/
infra/megadetector/out/
infra/megadetector/.wrangler/
infra/megadetector/*.pt
infra/megadetector/*.onnx
infra/megadetector/*.onnx.data

# Tauri Android wrapper — Rust build artefacts + tauri-generated
# per-platform source. Cargo.lock IS committed (binary crate
# convention) so CI builds are deterministic; do not add it here.
src-tauri/target/
src-tauri/gen/
src-tauri/icons/*.png
src-tauri/icons/*.icns
src-tauri/icons/*.ico
