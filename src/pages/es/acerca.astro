---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutView from '../../components/AboutView.astro';
import { t } from '../../i18n/utils';

const lang = 'es';
const tr = t(lang);
---

<BaseLayout
  title={`${tr.about.title} — Rastrum`}
  description="Rastrum es una plataforma open-source de observación de biodiversidad construida para América Latina. IA multi-modal, lenguas indígenas, alineada con CARE."
  lang={lang}
>
  <AboutView lang={lang} />
</BaseLayout>
