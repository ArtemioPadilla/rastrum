---
/**
 * PIT landing page — /es/explorar/pits/?slug=<slug>
 *
 * Thin wrapper. Body lives in `PitLandingView.astro` for EN/ES parity.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PitLandingView from '../../../../components/PitLandingView.astro';
import { t } from '../../../../i18n/utils';

const lang = 'es';
const slug = Astro.url.searchParams.get('slug') ?? '';
const tr = t(lang) as { pit_landing: Record<string, string> };
const title = slug ? tr.pit_landing.meta_title_detail : tr.pit_landing.meta_title_index;
const description = slug
  ? tr.pit_landing.meta_description_detail
  : tr.pit_landing.meta_description_index;
---
<BaseLayout title={title} description={description} lang={lang}>
  <PitLandingView lang={lang} slug={slug} />
</BaseLayout>
