---
/**
 * Senderos — /es/explorar/senderos/
 *
 * Página de doble modo (enrutamiento por query string, issue #1047):
 *   - Sin `?slug=` → muestra TrailsView (navegación + crear).
 *   - `?slug=<id>` → muestra el shell del detalle del sendero. El slug se
 *     lee del query param en cliente y se obtiene el sendero de Supabase.
 *
 * La guía de campo imprimible vive en /es/explorar/senderos/guia-de-campo/?slug=<id>.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TrailsView from '../../../../components/TrailsView.astro';

const lang = 'es';
const slug = Astro.url.searchParams.get('slug');
const isDetail = !!slug;

const title = isDetail ? 'Sendero — Rastrum' : 'Senderos de biodiversidad — Rastrum';
const description = isDetail
  ? 'Detalles del sendero de biodiversidad con puntos, observaciones y métricas de diversidad.'
  : 'Crea y explora senderos de biodiversidad con puntos GPS y observaciones de especies.';
---
<BaseLayout title={title} description={description} lang={lang}>
  {isDetail ? (
    <div id="trail-detail-root" data-lang={lang} data-slug={slug} class="space-y-6">

      <!-- Loading state -->
      <div id="trail-detail-loading">
        <div class="animate-pulse space-y-4">
          <div class="h-8 bg-zinc-200 dark:bg-zinc-700 rounded w-1/2"></div>
          <div class="h-4 bg-zinc-200 dark:bg-zinc-700 rounded w-1/3"></div>
          <div class="h-32 bg-zinc-200 dark:bg-zinc-700 rounded"></div>
        </div>
      </div>

      <!-- Content rendered by client script -->
      <div id="trail-detail-content" class="hidden space-y-6"></div>

      <!-- Error state -->
      <div id="trail-detail-error" class="hidden">
        <p class="text-sm text-red-500">Sendero no encontrado.</p>
      </div>

    </div>
  ) : (
    <TrailsView lang={lang} />
  )}
</BaseLayout>

<script>
  import { getSupabase } from '../../../../lib/supabase';

  const root = document.getElementById('trail-detail-root');
  if (root) {
    const slug = root.dataset.slug ?? '';
    const lang = root.dataset.lang ?? 'en';
    const isEs = lang === 'es';

    const loading = document.getElementById('trail-detail-loading')!;
    const content = document.getElementById('trail-detail-content')!;
    const errorEl = document.getElementById('trail-detail-error')!;

    function tr(en: string, es: string): string {
      return isEs ? es : en;
    }

    async function loadTrail(): Promise<void> {
      if (!slug) {
        showError();
        return;
      }

      try {
        const sb = getSupabase();
        const { data: trail, error } = await sb
          .from('trails')
          .select('*')
          .eq('id', slug)
          .single();

        if (error || !trail) {
          showError();
          return;
        }

        renderTrail(trail);
      } catch (err) {
        console.error('[TrailDetail] load error', err);
        showError();
      }
    }

    function showError(): void {
      loading.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }

    function escapeHtml(str: string): string {
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderTrail(trail: {
      id: string;
      name: string;
      name_es?: string;
      total_species: number;
      total_observations: number;
      waypoints: { lat: number; lng: number; name?: string; obs_count?: number }[];
      distance_km?: number | null;
      created_at: string;
      visibility: string;
    }): void {
      const displayName = isEs && trail.name_es ? trail.name_es : trail.name;
      const waypoints = Array.isArray(trail.waypoints) ? trail.waypoints : [];
      const fieldGuideBase = isEs ? `/${lang}/explorar/senderos/guia-de-campo/?slug=` : `/${lang}/explore/trails/field-guide/?slug=`;
      const fieldGuideHref = `${fieldGuideBase}${encodeURIComponent(trail.id)}`;

      const waypointRows = waypoints.map((wp, i) => `
        <tr class="border-t border-zinc-100 dark:border-zinc-800">
          <td class="py-2 px-3 text-xs text-zinc-500">${i + 1}</td>
          <td class="py-2 px-3 text-xs text-zinc-700 dark:text-zinc-300">${escapeHtml(wp.name ?? `WP ${i + 1}`)}</td>
          <td class="py-2 px-3 text-xs font-mono text-zinc-500">${Number(wp.lat).toFixed(5)}</td>
          <td class="py-2 px-3 text-xs font-mono text-zinc-500">${Number(wp.lng).toFixed(5)}</td>
          <td class="py-2 px-3 text-xs text-zinc-500">${wp.obs_count ?? 0}</td>
        </tr>
      `).join('');

      content.innerHTML = `
        <!-- Trail header -->
        <div class="space-y-1">
          <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
            ${escapeHtml(displayName)}
          </h1>
          <p class="text-xs text-zinc-400">
            ${tr('Created', 'Creado')} ${new Date(trail.created_at).toLocaleDateString(isEs ? 'es-MX' : 'en-US')}
            · ${trail.visibility === 'public' ? tr('Public', 'Público') : tr('Private', 'Privado')}
          </p>
        </div>

        <!-- Stats row -->
        <div class="flex flex-wrap gap-4">
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-center min-w-[80px]">
            <p class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">${trail.total_species}</p>
            <p class="text-xs text-zinc-500 mt-0.5">${tr('Species', 'Especies')}</p>
          </div>
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-center min-w-[80px]">
            <p class="text-2xl font-bold text-blue-600 dark:text-blue-400">${trail.total_observations}</p>
            <p class="text-xs text-zinc-500 mt-0.5">${tr('Observations', 'Observaciones')}</p>
          </div>
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-center min-w-[80px]">
            <p class="text-2xl font-bold text-zinc-700 dark:text-zinc-200">${waypoints.length}</p>
            <p class="text-xs text-zinc-500 mt-0.5">${tr('Waypoints', 'Puntos')}</p>
          </div>
          ${trail.distance_km != null ? `
          <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-center min-w-[80px]">
            <p class="text-2xl font-bold text-zinc-700 dark:text-zinc-200">${Number(trail.distance_km).toFixed(1)}</p>
            <p class="text-xs text-zinc-500 mt-0.5">km</p>
          </div>` : ''}
        </div>

        <!-- Waypoints table -->
        ${waypoints.length > 0 ? `
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 overflow-hidden">
          <table class="w-full text-left">
            <thead class="bg-zinc-50 dark:bg-zinc-800">
              <tr>
                <th class="py-2 px-3 text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">#</th>
                <th class="py-2 px-3 text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">${tr('Name', 'Nombre')}</th>
                <th class="py-2 px-3 text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">Lat</th>
                <th class="py-2 px-3 text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">Lng</th>
                <th class="py-2 px-3 text-[11px] font-semibold text-zinc-500 uppercase tracking-wide">${tr('Obs', 'Obs')}</th>
              </tr>
            </thead>
            <tbody>
              ${waypointRows}
            </tbody>
          </table>
        </div>` : `<p class="text-sm text-zinc-400">${tr('No waypoints recorded yet.', 'No hay puntos registrados aún.')}</p>`}

        <!-- Actions -->
        <div class="flex flex-wrap gap-3">
          <a
            href="${fieldGuideHref}"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
          >
            <span>📋</span>
            ${tr('Field Guide', 'Guía de campo')}
          </a>
        </div>
      `;

      loading.classList.add('hidden');
      content.classList.remove('hidden');
    }

    loadTrail();
  }
</script>
