---
/**
 * Guía de campo — /es/explorar/senderos/guia-de-campo/?slug=<id>
 *
 * Envoltorio delgado de `<TrailFieldGuideView />`. La vista compartida
 * emite el documento HTML completo (doctype, html, head, body, script en
 * línea) con CSS de impresión precargado — sin BaseLayout. Issue #1050.
 */
import TrailFieldGuideView from '../../../../../components/TrailFieldGuideView.astro';
const slug = Astro.url.searchParams.get('slug') ?? '';
---
<TrailFieldGuideView lang="es" slug={slug} />
