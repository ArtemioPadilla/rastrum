---
/**
 * Trails — /en/explore/trails/
 *
 * Dual-mode page (query-string routing per issue #1047):
 *   - No `?slug=` → renders TrailsView (browse + create UI).
 *   - `?slug=<id>` → renders TrailDetailView shell. The detail body is
 *     extracted into a shared component for EN/ES parity (issue #1050).
 *
 * Field-guide print view lives at /en/explore/trails/field-guide/?slug=<id>.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TrailsView from '../../../../components/TrailsView.astro';
import TrailDetailView from '../../../../components/TrailDetailView.astro';

const lang = 'en';
const slug = Astro.url.searchParams.get('slug') ?? '';
const isDetail = !!slug;

const title = isDetail ? 'Trail — Rastrum' : 'Biodiversity Trails — Rastrum';
const description = isDetail
  ? 'Biodiversity trail details with waypoints, observations, and diversity metrics.'
  : 'Create and explore biodiversity trails with GPS waypoints and species observations.';
---
<BaseLayout title={title} description={description} lang={lang}>
  {isDetail
    ? <TrailDetailView lang={lang} slug={slug} />
    : <TrailsView lang={lang} />}
</BaseLayout>
