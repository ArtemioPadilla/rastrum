---
/**
 * Field guide page — /en/explore/trails/field-guide/?slug=<id>
 *
 * Thin wrapper around `<TrailFieldGuideView />`. The shared View renders the
 * full standalone HTML document (doctype, html, head, body, inline script)
 * with print-only CSS pre-loaded — no BaseLayout. Issue #1050.
 */
import TrailFieldGuideView from '../../../../../components/TrailFieldGuideView.astro';
const slug = Astro.url.searchParams.get('slug') ?? '';
---
<TrailFieldGuideView lang="en" slug={slug} />
