---
/**
 * Species list detail page — EN variant.
 * Route: /en/profile/u/lists/?username=<u>&slug=<s>
 * Issue #1047 — query-string routing.
 * Issue #1050 — body extracted to shared UserListDetailView.
 */
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import UserListDetailView from '../../../../../components/UserListDetailView.astro';
import { t } from '../../../../../i18n/utils';

const lang = 'en' as const;
const tr = t(lang);
const d = tr.user_list_detail;
const username = Astro.url.searchParams.get('username') ?? '';
const slug = Astro.url.searchParams.get('slug') ?? '';
---

<BaseLayout title={d.page_title} description={d.meta_description} lang={lang} robots="noindex,nofollow">
  <UserListDetailView lang={lang} username={username} slug={slug} />
</BaseLayout>
