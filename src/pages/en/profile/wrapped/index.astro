---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const lang = 'en';
const year = Astro.url.searchParams.get('year') ?? new Date().getFullYear().toString();
---

<BaseLayout
  title={`Your ${year} in Rastrum · Wrapped`}
  description={`Review your ${year} biodiversity year — species seen, habitats visited, and more.`}
  lang={lang}
>
  <main class="min-h-screen bg-zinc-950 text-white" data-lang={lang} data-year={year} id="wrapped-root">
    <!-- Loading -->
    <div id="wrapped-loading" class="flex flex-col items-center justify-center min-h-screen gap-4">
      <div class="w-10 h-10 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-zinc-400 text-sm">Loading your {year} Wrapped…</p>
    </div>

    <!-- Cards (scroll-snap) -->
    <div id="wrapped-cards" class="hidden snap-y snap-mandatory overflow-y-scroll h-screen">

      <!-- Card 1: Hero -->
      <section class="snap-start flex flex-col items-center justify-center min-h-screen p-8 text-center bg-gradient-to-b from-emerald-950 to-zinc-950">
        <p class="text-emerald-400 text-sm font-semibold uppercase tracking-widest mb-2">Rastrum Wrapped</p>
        <h1 class="text-5xl font-extrabold mb-4">Your {year}</h1>
        <p class="text-zinc-400 mb-8">A year of biodiversity, in numbers.</p>
        <div class="flex gap-8">
          <div class="text-center">
            <div id="w-total-obs" class="text-4xl font-bold text-emerald-400">—</div>
            <div class="text-xs text-zinc-400 mt-1 uppercase tracking-wider">Observations</div>
          </div>
          <div class="text-center">
            <div id="w-total-spp" class="text-4xl font-bold text-emerald-400">—</div>
            <div class="text-xs text-zinc-400 mt-1 uppercase tracking-wider">Species</div>
          </div>
        </div>
        <button class="mt-8 text-xs text-zinc-500 animate-bounce">Scroll down ↓</button>
      </section>

      <!-- Card 2: Top species -->
      <section class="snap-start flex flex-col justify-center min-h-screen p-8 bg-zinc-950">
        <h2 class="text-2xl font-bold mb-6">🦋 Your top species</h2>
        <ul id="w-top-species" class="space-y-3"></ul>
      </section>

      <!-- Card 3: Habitats -->
      <section class="snap-start flex flex-col justify-center min-h-screen p-8 bg-gradient-to-b from-zinc-950 to-emerald-950">
        <h2 class="text-2xl font-bold mb-6">🌿 Habitats explored</h2>
        <div id="w-habitats" class="space-y-2"></div>
      </section>

      <!-- Card 4: Streak -->
      <section class="snap-start flex flex-col items-center justify-center min-h-screen p-8 text-center bg-zinc-950">
        <h2 class="text-2xl font-bold mb-4">🔥 Your streak record</h2>
        <div id="w-streak" class="text-6xl font-extrabold text-amber-400 mb-2">—</div>
        <p class="text-zinc-400 text-sm">consecutive days</p>
        <div class="mt-8 grid grid-cols-2 gap-4 text-sm text-zinc-400">
          <div>First obs: <span id="w-first-obs" class="text-white">—</span></div>
          <div>Last obs: <span id="w-last-obs" class="text-white">—</span></div>
        </div>
      </section>

      <!-- Card 5: Top photo -->
      <section class="snap-start flex flex-col items-center justify-center min-h-screen p-8 bg-zinc-950">
        <h2 class="text-2xl font-bold mb-6">📷 Your most loved photo</h2>
        <div id="w-top-photo-container" class="w-full max-w-sm">
          <p id="w-no-photo" class="text-zinc-500 text-sm">No photo data available.</p>
          <a id="w-top-photo-link" href="#" class="hidden block">
            <img id="w-top-photo" src="" alt="Top photo" class="rounded-xl w-full object-cover max-h-64" />
          </a>
        </div>
      </section>

      <!-- Card 6: Impact -->
      <section class="snap-start flex flex-col justify-center min-h-screen p-8 bg-gradient-to-b from-zinc-950 to-emerald-950">
        <h2 class="text-2xl font-bold mb-6">🌍 Your impact</h2>
        <div class="space-y-4">
          <div class="rounded-xl bg-white/5 p-4">
            <div id="w-dwc-count" class="text-3xl font-bold text-emerald-400">—</div>
            <div class="text-sm text-zinc-400 mt-1">DwC exports your data appeared in</div>
          </div>
          <div class="rounded-xl bg-white/5 p-4">
            <div id="w-threatened-count" class="text-3xl font-bold text-red-400">—</div>
            <div class="text-sm text-zinc-400 mt-1">NOM-059 threatened species documented</div>
          </div>
        </div>
        <div class="mt-8">
          <a
            id="w-share-btn"
            href="#"
            class="block w-full text-center rounded-xl bg-emerald-600 hover:bg-emerald-700 px-4 py-3 font-semibold text-sm"
          >
            Share your Wrapped →
          </a>
        </div>
      </section>

    </div>

    <!-- Error state -->
    <div id="wrapped-error" class="hidden flex flex-col items-center justify-center min-h-screen gap-4 text-center p-8">
      <div class="text-5xl">😔</div>
      <h2 class="text-xl font-bold">Could not load your Wrapped</h2>
      <p class="text-zinc-400 text-sm">Make sure you're signed in and have observations for {year}.</p>
      <a href="/en/profile/" class="text-emerald-400 hover:underline text-sm">← Back to profile</a>
    </div>
  </main>
</BaseLayout>

<script>
  import { getCachedUser, getSupabase } from '../../../../lib/supabase';

  interface WrappedPayload {
    year: number;
    total_observations: number;
    total_species: number;
    top_species: Array<{ scientific_name: string; common_name_en: string | null; count: number; thumbnail_url: string | null }>;
    habitats: Array<{ habitat: string; count: number }>;
    longest_streak_days: number;
    first_obs_date: string | null;
    last_obs_date: string | null;
    top_photo_url: string | null;
    top_photo_obs_id: string | null;
    dwc_export_count: number;
    threatened_species_count: number;
    peak_hour: number | null;
  }

  const root = document.getElementById('wrapped-root');
  const year = root?.dataset.year ?? new Date().getFullYear().toString();
  const loadingEl = document.getElementById('wrapped-loading');
  const cardsEl   = document.getElementById('wrapped-cards');
  const errorEl   = document.getElementById('wrapped-error');

  function show(el: HTMLElement | null) { el?.classList.remove('hidden'); }
  function hide(el: HTMLElement | null) { el?.classList.add('hidden'); }

  async function load() {
    const supabase = getSupabase();
    const user = await getCachedUser();
    if (!user) { hide(loadingEl); show(errorEl); return; }

    try {
      const resp = await supabase.functions.invoke('generate-wrapped', {
        body: null,
        headers: {},
      });
      // Pass year + user_id as query params via URL construction
      const fnUrl = `${(import.meta.env.PUBLIC_SUPABASE_URL as string)}/functions/v1/generate-wrapped?year=${year}&user_id=${user.id}`;
      const token = (await supabase.auth.getSession()).data.session?.access_token;
      const res = await fetch(fnUrl, { headers: { Authorization: `Bearer ${token ?? ''}` } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data: WrappedPayload = await res.json();
      render(data);
    } catch {
      hide(loadingEl);
      show(errorEl);
    }
  }

  function render(d: WrappedPayload) {
    // Card 1
    const setText = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };
    setText('w-total-obs', d.total_observations.toLocaleString());
    setText('w-total-spp', d.total_species.toLocaleString());

    // Card 2: top species
    const ul = document.getElementById('w-top-species');
    if (ul) {
      ul.innerHTML = '';
      for (const [i, sp] of (d.top_species ?? []).entries()) {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-3';
        li.innerHTML = `
          <span class="text-2xl font-bold text-emerald-400/50">${i + 1}</span>
          ${sp.thumbnail_url ? `<img src="${sp.thumbnail_url}" class="w-10 h-10 rounded-lg object-cover flex-shrink-0" alt="" />` : '<div class="w-10 h-10 rounded-lg bg-white/10 flex-shrink-0"></div>'}
          <div>
            <div class="font-semibold italic">${sp.scientific_name}</div>
            ${sp.common_name_en ? `<div class="text-xs text-zinc-400">${sp.common_name_en}</div>` : ''}
          </div>
          <span class="ml-auto text-xs text-zinc-400">${sp.count}×</span>
        `;
        ul.appendChild(li);
      }
    }

    // Card 3: habitats
    const habitatsEl = document.getElementById('w-habitats');
    if (habitatsEl) {
      habitatsEl.innerHTML = '';
      const maxCount = Math.max(...(d.habitats ?? []).map(h => h.count), 1);
      for (const h of d.habitats ?? []) {
        const pct = Math.round((h.count / maxCount) * 100);
        const bar = document.createElement('div');
        bar.innerHTML = `
          <div class="flex justify-between text-sm mb-1">
            <span class="capitalize">${h.habitat}</span>
            <span class="text-zinc-400">${h.count}</span>
          </div>
          <div class="h-2 rounded-full bg-white/10">
            <div class="h-2 rounded-full bg-emerald-500" style="width:${pct}%"></div>
          </div>
        `;
        habitatsEl.appendChild(bar);
      }
    }

    // Card 4: streak
    setText('w-streak', String(d.longest_streak_days));
    setText('w-first-obs', d.first_obs_date ? new Date(d.first_obs_date).toLocaleDateString('en') : '—');
    setText('w-last-obs', d.last_obs_date  ? new Date(d.last_obs_date).toLocaleDateString('en') : '—');

    // Card 5: top photo
    if (d.top_photo_url) {
      const img = document.getElementById('w-top-photo') as HTMLImageElement | null;
      const link = document.getElementById('w-top-photo-link') as HTMLAnchorElement | null;
      const noPhoto = document.getElementById('w-no-photo');
      if (img) img.src = d.top_photo_url;
      if (link) { link.href = `/en/observations/${d.top_photo_obs_id}/`; show(link); }
      hide(noPhoto);
    }

    // Card 6: impact
    setText('w-dwc-count', String(d.dwc_export_count));
    setText('w-threatened-count', String(d.threatened_species_count));

    const shareBtn = document.getElementById('w-share-btn') as HTMLAnchorElement | null;
    if (shareBtn) shareBtn.href = `/en/profile/wrapped/?year=${year}`;

    hide(loadingEl);
    show(cardsEl);
  }

  void load().catch(() => { hide(loadingEl); show(errorEl); });
</script>
