---
/**
 * InstitutionBadge — shows "Validado por experto · CONANP" with the
 * institution short name when the validator has an admin-verified affiliation.
 *
 * Issue #735: Institutional endorsement badges.
 */
interface Props {
  /** Institution short name, e.g. 'CONANP'. Null = hide the badge. */
  institution: string | null;
  /** Whether this is a verified affiliation (admin-approved). */
  verified?: boolean;
  /** Display language. */
  lang?: 'es' | 'en';
}
const { institution, verified = true, lang = 'es' } = Astro.props;
const show = institution && verified;
---

{show && (
  <span
    class="inline-flex items-center gap-1 text-[11px] font-medium px-2 py-0.5 rounded-full border
           bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border-blue-200 dark:border-blue-800"
    title={lang === 'es'
      ? `Validado por experto afiliado a ${institution}`
      : `Validated by expert affiliated with ${institution}`}
  >
    <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
    </svg>
    <span>{lang === 'es' ? 'Experto' : 'Expert'} · {institution}</span>
  </span>
)}
