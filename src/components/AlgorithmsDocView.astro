---
import { ALGORITHMS } from '../lib/algorithms';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const isEs = lang === 'es';

const ids = Object.keys(ALGORITHMS) as Array<keyof typeof ALGORITHMS>;
---

<article class="prose prose-zinc dark:prose-invert max-w-none">
  <h1>{isEs ? 'Algoritmos de Rastrum' : 'Rastrum Algorithms'}</h1>
  <p class="lead text-lg text-zinc-600 dark:text-zinc-400">
    {isEs
      ? 'Toda superficie ordenada en Rastrum tiene una entrada en este catálogo. La intención es que veas el "por qué" de cada ranking, no solo el resultado.'
      : 'Every ranked surface in Rastrum has an entry in this catalog. The intent is for you to see the "why" of each ranking, not just the result.'}
  </p>

  <p>
    {isEs
      ? 'Cada superficie clasificada incluye un enlace "¿Por qué veo esto?" que abre un modal con las entradas, la ventana de tiempo y un enlace a los ajustes correspondientes. Esta página sirve como referencia consolidada.'
      : 'Each ranked surface ships with a "Why am I seeing this?" link that opens a modal with the inputs, time window, and a link to the relevant settings. This page is the consolidated reference.'}
  </p>

  <h2>{isEs ? 'Principios' : 'Principles'}</h2>
  <ul>
    <li>{isEs
      ? 'Sin caja negra: cada ranking documenta sus entradas explícitamente.'
      : 'No black box: every ranking documents its inputs explicitly.'}</li>
    <li>{isEs
      ? 'Sin perfilado oculto: si una entrada usa tu actividad o ubicación, lo dice.'
      : 'No hidden profiling: if an input uses your activity or location, we say so.'}</li>
    <li>{isEs
      ? 'Una palanca para cada entrada: si la quieres apagar, hay un ajuste claro.'
      : 'A lever for every input: if you want to turn it off, there is a clear setting.'}</li>
    <li>{isEs
      ? 'Sin engagement bait: las superficies de Rastrum no se ordenan por likes ni reacciones.'
      : 'No engagement bait: Rastrum surfaces are not sorted by likes or reactions.'}</li>
  </ul>

  {ids.map((id) => {
    const entry = ALGORITHMS[id];
    const copy = isEs ? entry.copy.es : entry.copy.en;
    return (
      <section class="not-prose mt-10 rounded-xl border border-zinc-200 dark:border-zinc-800 p-5 space-y-3">
        <header>
          <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
            {isEs ? entry.headline.es : entry.headline.en}
          </h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            {isEs ? entry.summary.es : entry.summary.en}
          </p>
          <p class="text-[11px] uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mt-1">
            <code class="text-[11px]">{id}</code>
          </p>
        </header>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
            {isEs ? 'Entradas usadas' : 'Inputs used'}
          </h4>
          <ul class="list-disc pl-5 space-y-1 text-sm text-zinc-800 dark:text-zinc-200">
            {copy.inputs.map((input) => (<li>{input}</li>))}
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
            {isEs ? 'Ventana de tiempo' : 'Time window'}
          </h4>
          <p class="text-sm text-zinc-800 dark:text-zinc-200">{copy.window}</p>
        </div>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1.5">
            {isEs ? '¿Cómo cambio esto?' : 'How do I change this?'}
          </h4>
          <a
            href={isEs ? entry.settings_path.es + '/' : entry.settings_path.en + '/'}
            class="text-sm font-medium text-emerald-700 dark:text-emerald-400 hover:underline"
          >
            {copy.settings_label} →
          </a>
        </div>
      </section>
    );
  })}

  <h2 class="mt-10">{isEs ? 'Lo que NO hacemos' : 'What we do NOT do'}</h2>
  <ul>
    <li>{isEs
      ? 'No hay un feed personalizado opaco como TikTok o Instagram.'
      : 'There is no opaque personalised feed like TikTok or Instagram.'}</li>
    <li>{isEs
      ? 'No vendemos tu actividad ni tu ubicación a terceros.'
      : 'We do not sell your activity or location to third parties.'}</li>
    <li>{isEs
      ? 'Las observaciones privadas nunca aparecen en superficies públicas, incluso si tu cuenta es pública.'
      : 'Private observations never appear in public surfaces, even when your account is public.'}</li>
  </ul>

  <p class="text-sm text-zinc-500 mt-8">
    {isEs ? 'Catálogo: ' : 'Catalog: '}
    <a href="https://github.com/ArtemioPadilla/rastrum/blob/main/src/lib/algorithms.ts" class="underline">src/lib/algorithms.ts</a>
  </p>
</article>
