---
/**
 * DisambiguationView — per-trait photo capture panel for the v1.1 cascade polish.
 * Closes #683 (disambiguation v1.1 polish).
 *
 * Mounted inside the ObserveView2 cascade result flow when the cascade
 * returns `kind: 'uncertain'` with an LLM-generated disambiguation prompt.
 *
 * Features (v1.1):
 * 1. Per-trait labelled photo capture: file input labelled with the trait
 *    name (e.g. "leaf underside", "flower close-up") derived from the
 *    LLM disambiguation prompt. Passes `data-trait-hint` on the input.
 * 2. Image grid examples: shows 2-3 reference images per disambiguation
 *    trait from taxa media if available (lazy-loaded client-side).
 * 3. Multi-photo cascade: allows up to 3 photos; all are passed to the
 *    cascade re-run so the second shot reinforces (not overrides) the first.
 *
 * Wiring contract:
 *   - Mount this component in the pipeline output area.
 *   - Set `data-scientific-name` on the root when the cascade resolves
 *     with an uncertain result.
 *   - Set `data-trait-prompt` to the LLM-generated disambiguation prompt
 *     (e.g. "Photograph the leaf underside and the flower petals closely.")
 *   - Listen for `rastrum:disambiguation-photos` on `window`:
 *       event.detail.files — FileList-like array of selected files (1-3)
 *       event.detail.traitHints — matching trait label for each file
 */
import { t } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const isEs = lang === 'es';

const labels = {
  heading:       isEs ? '¿Podemos precisar más?' : 'Can we narrow it down?',
  subheading:    isEs
    ? 'El sistema no está seguro. Una foto adicional del rasgo clave ayuda.'
    : 'The system is uncertain. A photo of the key diagnostic feature helps.',
  prompt_prefix: isEs ? 'Rasgo diagnóstico:' : 'Diagnostic trait:',
  addPhoto:      isEs ? 'Tomar foto' : 'Take photo',
  addPhotoHint:  isEs ? 'Hasta 3 fotos en total' : 'Up to 3 photos total',
  refPhotos:     isEs ? 'Fotos de referencia' : 'Reference photos',
  refLoading:    isEs ? 'Cargando ejemplos…' : 'Loading examples…',
  refEmpty:      isEs ? 'Sin fotos de referencia aún.' : 'No reference photos yet.',
  runCascade:    isEs ? 'Re-identificar con fotos adicionales' : 'Re-identify with extra photos',
  skip:          isEs ? 'Continuar sin fotos adicionales' : 'Continue without extra photos',
  maxPhotos:     isEs ? 'Máximo 3 fotos' : 'Maximum 3 photos',
  traitHints: {
    leaf_underside:   isEs ? 'Envés de la hoja'    : 'Leaf underside',
    flower_closeup:   isEs ? 'Flor (close-up)'     : 'Flower close-up',
    bark:             isEs ? 'Corteza del tronco'  : 'Bark / trunk',
    fruit_seed:       isEs ? 'Fruto / semilla'     : 'Fruit / seed',
    whole_plant:      isEs ? 'Planta completa'     : 'Whole plant',
    wing_pattern:     isEs ? 'Patrón alar'         : 'Wing pattern',
    dorsal:           isEs ? 'Vista dorsal'        : 'Dorsal view',
    ventral:          isEs ? 'Vista ventral'       : 'Ventral view',
    head_closeup:     isEs ? 'Cabeza (close-up)'   : 'Head close-up',
  } as Record<string, string>,
};
---

<div
  id="rastrum-disambiguation"
  data-lang={lang}
  data-scientific-name=""
  data-trait-prompt=""
  data-label-max-photos={labels.maxPhotos}
  class="hidden rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 p-4 space-y-4"
>
  <!-- Header -->
  <div>
    <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">
      {labels.heading}
    </h3>
    <p class="text-xs text-amber-800 dark:text-amber-300 mt-0.5">{labels.subheading}</p>
  </div>

  <!-- Trait prompt (populated by JS from data-trait-prompt) -->
  <div id="disambig-trait-prompt" class="hidden rounded-lg bg-white dark:bg-zinc-900 border border-amber-200 dark:border-amber-700 px-3 py-2">
    <p class="text-xs font-medium text-zinc-600 dark:text-zinc-400 mb-1">{labels.prompt_prefix}</p>
    <p id="disambig-trait-text" class="text-sm text-zinc-800 dark:text-zinc-200"></p>
  </div>

  <!-- Trait-labelled capture buttons (up to 3, generated by JS) -->
  <div id="disambig-capture-slots" class="space-y-2"></div>

  <!-- Reference photos per trait (lazy-loaded) -->
  <div id="disambig-ref-section" class="hidden">
    <h4 class="text-xs font-medium text-zinc-600 dark:text-zinc-400 mb-2">{labels.refPhotos}</h4>
    <div id="disambig-ref-grid" class="grid grid-cols-3 gap-2">
      <p id="disambig-ref-loading" class="col-span-3 text-xs text-zinc-400 italic">{labels.refLoading}</p>
    </div>
  </div>

  <!-- Multi-photo selected preview -->
  <div id="disambig-selected-preview" class="hidden">
    <div id="disambig-selected-grid" class="grid grid-cols-3 gap-2"></div>
  </div>

  <!-- CTA row -->
  <div class="flex flex-wrap gap-2">
    <button
      id="disambig-run-btn"
      type="button"
      disabled
      class="min-h-[38px] rounded-xl bg-amber-700 hover:bg-amber-800 disabled:opacity-40 disabled:cursor-not-allowed text-white font-semibold text-xs px-4 transition-colors"
    >{labels.runCascade}</button>
    <button
      id="disambig-skip-btn"
      type="button"
      class="min-h-[38px] rounded-xl border border-zinc-300 dark:border-zinc-700 text-xs px-4 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors"
    >{labels.skip}</button>
  </div>
</div>

<script>
  import { getSupabase } from '../lib/supabase';
  import { resolveTaxonId } from '../lib/why-this-species';
  import { showToast } from '../lib/toast';

  const MAX_PHOTOS = 3;

  // ---------------------------------------------------------------------------
  // Trait extraction from LLM prompt
  // ---------------------------------------------------------------------------

  /**
   * Known diagnostic trait keywords → canonical trait key.
   * We match these against the LLM disambiguation prompt to label the CTAs.
   */
  const TRAIT_KEYWORDS: Record<string, string[]> = {
    leaf_underside:  ['leaf underside', 'envés', 'envés de la hoja', 'underside of the leaf'],
    flower_closeup:  ['flower', 'flor', 'petal', 'pétalo', 'inflorescence', 'inflorescencia'],
    bark:            ['bark', 'corteza', 'trunk', 'tronco'],
    fruit_seed:      ['fruit', 'fruto', 'seed', 'semilla', 'berry', 'baya'],
    whole_plant:     ['whole plant', 'planta completa', 'habit', 'porte'],
    wing_pattern:    ['wing', 'ala', 'wing pattern', 'patrón alar'],
    dorsal:          ['dorsal', 'dorsal view', 'vista dorsal', 'top'],
    ventral:         ['ventral', 'ventral view', 'vista ventral', 'underside'],
    head_closeup:    ['head', 'cabeza', 'face', 'cara', 'eye', 'ojo'],
  };

  const TRAIT_LABELS_EN: Record<string, string> = {
    leaf_underside: 'Leaf underside',
    flower_closeup: 'Flower close-up',
    bark:           'Bark / trunk',
    fruit_seed:     'Fruit / seed',
    whole_plant:    'Whole plant',
    wing_pattern:   'Wing pattern',
    dorsal:         'Dorsal view',
    ventral:        'Ventral view',
    head_closeup:   'Head close-up',
  };

  const TRAIT_LABELS_ES: Record<string, string> = {
    leaf_underside: 'Envés de la hoja',
    flower_closeup: 'Flor (close-up)',
    bark:           'Corteza del tronco',
    fruit_seed:     'Fruto / semilla',
    whole_plant:    'Planta completa',
    wing_pattern:   'Patrón alar',
    dorsal:         'Vista dorsal',
    ventral:        'Vista ventral',
    head_closeup:   'Cabeza (close-up)',
  };

  function extractTraitsFromPrompt(prompt: string): string[] {
    const lower = prompt.toLowerCase();
    const found: string[] = [];
    for (const [key, keywords] of Object.entries(TRAIT_KEYWORDS)) {
      if (keywords.some(kw => lower.includes(kw)) && !found.includes(key)) {
        found.push(key);
        if (found.length >= 2) break; // max 2 distinct trait CTAs
      }
    }
    if (found.length === 0) found.push('whole_plant'); // generic fallback
    return found;
  }

  function getTraitLabel(key: string, lang: string): string {
    const map = lang === 'es' ? TRAIT_LABELS_ES : TRAIT_LABELS_EN;
    return map[key] ?? key;
  }

  // ---------------------------------------------------------------------------
  // State
  // ---------------------------------------------------------------------------
  const selectedFiles: Array<{ file: File; traitHint: string }> = [];

  function updateRunButton() {
    const btn = document.getElementById('disambig-run-btn') as HTMLButtonElement | null;
    if (btn) btn.disabled = selectedFiles.length === 0;
  }

  function renderSelectedPreview(root: HTMLElement) {
    const preview = root.querySelector<HTMLElement>('#disambig-selected-preview');
    const grid    = root.querySelector<HTMLElement>('#disambig-selected-grid');
    if (!preview || !grid) return;

    if (selectedFiles.length === 0) {
      preview.classList.add('hidden');
      return;
    }

    preview.classList.remove('hidden');
    grid.innerHTML = selectedFiles.map((entry, i) => {
      const url = URL.createObjectURL(entry.file);
      return `<div class="relative">
        <img src="${url}" alt="${entry.traitHint}" class="w-full h-20 object-cover rounded-lg border border-zinc-200 dark:border-zinc-700" />
        <span class="absolute bottom-0 left-0 right-0 bg-black/50 text-white text-[9px] px-1 py-0.5 rounded-b-lg truncate">${entry.traitHint}</span>
        <button
          type="button"
          data-remove-idx="${i}"
          class="absolute top-1 right-1 bg-black/50 text-white rounded-full w-4 h-4 text-[10px] flex items-center justify-center hover:bg-red-500"
        >×</button>
      </div>`;
    }).join('');

    // Wire remove buttons
    grid.querySelectorAll<HTMLButtonElement>('[data-remove-idx]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.removeIdx ?? '0', 10);
        selectedFiles.splice(idx, 1);
        renderSelectedPreview(root);
        updateRunButton();
      });
    });
  }

  function buildCaptureSlot(traitKey: string, traitLabel: string, lang: string): string {
    const addLabel    = lang === 'es' ? 'Tomar foto' : 'Take photo';
    return `
      <div class="flex items-center gap-3 rounded-lg border border-amber-200 dark:border-amber-700 bg-white dark:bg-zinc-900 px-3 py-2">
        <div class="flex-1 min-w-0">
          <p class="text-xs font-semibold text-zinc-800 dark:text-zinc-200 truncate">${traitLabel}</p>
          <p class="text-[10px] text-zinc-500 dark:text-zinc-400">${lang === 'es' ? 'Adjunta una foto de este rasgo' : 'Attach a photo of this trait'}</p>
        </div>
        <label class="cursor-pointer shrink-0">
          <span class="inline-flex items-center gap-1 rounded-lg bg-amber-700 hover:bg-amber-800 text-white text-xs font-medium px-3 py-1.5 transition-colors">
            📷 ${addLabel}
          </span>
          <input
            type="file"
            accept="image/*"
            capture="environment"
            class="sr-only"
            data-trait-hint="${traitKey}"
            data-trait-label="${traitLabel}"
          />
        </label>
      </div>
    `;
  }

  // ---------------------------------------------------------------------------
  // Reference photos
  // ---------------------------------------------------------------------------
  async function loadRefPhotos(root: HTMLElement, scientificName: string): Promise<void> {
    const section = root.querySelector<HTMLElement>('#disambig-ref-section');
    const grid    = root.querySelector<HTMLElement>('#disambig-ref-grid');
    const loading = root.querySelector<HTMLElement>('#disambig-ref-loading');
    if (!section || !grid) return;

    section.classList.remove('hidden');

    let supabase;
    try { supabase = getSupabase(); } catch { if (loading) loading.textContent = ''; return; }

    const taxonId = await resolveTaxonId(supabase, scientificName);
    if (!taxonId) { if (loading) loading.classList.add('hidden'); return; }

    // Fetch up to 3 validated reference photos for this taxon
    const { data } = await supabase
      .from('observations')
      .select('id, media_files(url, thumbnail_url, is_primary)')
      .eq('primary_taxon_id', taxonId)
      .eq('sync_status', 'synced')
      .not('media_files', 'is', null)
      .order('quality_grade', { ascending: false })
      .limit(3);

    if (loading) loading.classList.add('hidden');
    if (!data || data.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'col-span-3 text-xs text-zinc-400 italic';
      empty.textContent = root.dataset.labelRefEmpty ?? 'No reference photos yet.';
      grid.appendChild(empty);
      return;
    }

    grid.innerHTML = data.map(obs => {
      const mf = Array.isArray(obs.media_files)
        ? (obs.media_files.find((m: { is_primary: boolean }) => m.is_primary) ?? obs.media_files[0])
        : null;
      if (!mf) return '';
      const url = mf.thumbnail_url ?? mf.url ?? '';
      return `<a href="/share/obs/?id=${obs.id}" target="_blank" rel="noopener">
        <img src="${url}" alt="${scientificName}" class="w-full h-20 object-cover rounded-lg border border-zinc-200 dark:border-zinc-700 hover:opacity-80 transition-opacity" loading="lazy" />
      </a>`;
    }).filter(Boolean).join('');
  }

  // ---------------------------------------------------------------------------
  // Mount
  // ---------------------------------------------------------------------------
  function mountDisambiguationView(root: HTMLElement) {
    const lang = root.dataset.lang ?? 'en';

    // Watch for dataset updates from the host page
    const observer = new MutationObserver(() => {
      const scientificName = root.dataset.scientificName ?? '';
      const traitPrompt    = root.dataset.traitPrompt ?? '';

      if (!scientificName || root.classList.contains('hidden')) return;

      // Clear state on re-mount
      selectedFiles.length = 0;
      updateRunButton();

      // Show trait prompt
      const promptSection = root.querySelector<HTMLElement>('#disambig-trait-prompt');
      const promptText    = root.querySelector<HTMLElement>('#disambig-trait-text');
      if (traitPrompt && promptSection && promptText) {
        promptText.textContent = traitPrompt;
        promptSection.classList.remove('hidden');
      }

      // Build capture slots from extracted traits
      const slots     = root.querySelector<HTMLElement>('#disambig-capture-slots');
      if (slots) {
        const traits = extractTraitsFromPrompt(traitPrompt);
        slots.innerHTML = traits.map(tk => buildCaptureSlot(tk, getTraitLabel(tk, lang), lang)).join('');

        // Wire file inputs
        slots.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach(input => {
          input.addEventListener('change', () => {
            if (!input.files || input.files.length === 0) return;
            if (selectedFiles.length >= MAX_PHOTOS) {
              const msg = root.dataset.labelMaxPhotos ?? (lang === 'es' ? 'Máximo 3 fotos' : 'Maximum 3 photos');
              showToast({ message: msg, variant: 'error' });
              return;
            }
            const traitHint  = input.dataset.traitHint ?? 'unknown';
            const traitLabel = input.dataset.traitLabel ?? traitHint;
            selectedFiles.push({ file: input.files[0], traitHint: traitLabel });
            input.value = ''; // reset so same trait can be re-captured
            renderSelectedPreview(root);
            updateRunButton();
          });
        });
      }

      // Load reference photos
      void loadRefPhotos(root, scientificName);
    });

    observer.observe(root, { attributes: true, attributeFilter: ['data-scientific-name', 'data-trait-prompt', 'class'] });

    // Wire Run button
    root.querySelector('#disambig-run-btn')?.addEventListener('click', () => {
      if (selectedFiles.length === 0) return;
      window.dispatchEvent(new CustomEvent('rastrum:disambiguation-photos', {
        detail: {
          files: selectedFiles.map(e => e.file),
          traitHints: selectedFiles.map(e => e.traitHint),
        },
      }));
    });

    // Wire Skip button
    root.querySelector('#disambig-skip-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('rastrum:disambiguation-skip'));
    });
  }

  const root = document.getElementById('rastrum-disambiguation');
  if (root) mountDisambiguationView(root);
</script>
