    paintConversation();
    void clearChatHistory(chatStore).catch(() => { /* best effort */ });
  });

  // ── Consent + setup ──
  async function refreshState() {
    try {
      const lib = await import('../lib/local-ai');
      if (!lib.localAISupported()) {
        consentBox?.classList.remove('hidden');
        unsupNote?.classList.remove('hidden');
        if (downloadBtn) downloadBtn.disabled = true;
        return;
      }
      const llamaStatus = await lib.getModelCacheStatus(lib.TEXT_MODEL_ID);
      // Also probe Gemma cache — if the user already downloaded it from
      // Profile → AI settings (or the consent gate), the chat is ready.
      let gemmaCached = false;
      try {
        const ov = await import('../lib/onnx-vision');
        const g = await ov.getGemmaCacheStatus();
        gemmaCached = g.cached;
      } catch {
        // transformers.js not yet loaded — that's fine.
      }
      if (llamaStatus.cached || gemmaCached) {
        modelReady = true;
        consentBox?.classList.add('hidden');
        historyEl?.classList.remove('hidden');
        formEl?.classList.remove('hidden');
        await restoreChatHistory();
        paintConversation();
        // chat-phi-autoload: when Phi-3.5-vision weights are already cached
        // from a previous session, warm the engine in the background so the
        // first vision-attachment send doesn't trigger a consent modal.
        autoloadVisionEngineIfCached();
      } else {
        consentBox?.classList.remove('hidden');
        historyEl?.classList.add('hidden');
        formEl?.classList.add('hidden');
      }
    } catch {
      consentBox?.classList.remove('hidden');
    }
  }
  refreshState();

  /** Load the Phi-vision engine silently when its weights are already cached. */
  function autoloadVisionEngineIfCached(): void {
    void (async () => {
      try {
        const lib = await import('../lib/local-ai');
        if (!lib.localAISupported()) return;
        const status = await lib.getModelCacheStatus(lib.VISION_MODEL_ID);
        if (!status.cached) return;
        await lib.loadVisionEngine(() => { /* silent — already cached */ });
      } catch { /* best effort */ }
    })();
  }

  async function restoreChatHistory(): Promise<void> {
    try {
      const recent = await readRecentTurns(chatStore);
      for (const r of recent) {
        const att = r.attachments?.[0];
        const turn: ChatTurn = {
          role: r.role,
          content: r.content,
        };
        if (att && att.scientific_name) {
          turn.cascadeResult = {
            best: {
              scientific_name: att.scientific_name,
              common_name_en: null,
              common_name_es: null,
              family: null,
              kingdom: 'Unknown',
              confidence: att.confidence ?? 0,
              source: att.source ?? 'human',
            },
            attachmentKind: att.kind,
            attachmentBlobUrl: '',
            attachmentMime: att.mime_type,
          };
        }
        conversation.push(turn);
      }
    } catch { /* best effort */ }
  }

  /** Persist a user turn before the LLM call. */
  function persistUserTurn(text: string, att: ChatAttachment | null): void {
    const attachments = att ? [{
      kind: att.kind,
      mime_type: att.mimeType,
      duration_sec: att.durationSec,
    }] : undefined;
    void appendTurn(chatStore, {
      id: makeTurnId(),
      role: 'user',
      content: text,
      attachments,
    }).catch(() => { /* best effort */ });
  }

  /** Persist an assistant turn after streaming completes. */
  function persistAssistantTurn(turn: ChatTurn): void {
    if (turn.pending) return;
    const cr = turn.cascadeResult;
    const attachments = cr?.best ? [{
      kind: cr.attachmentKind,
      mime_type: cr.attachmentMime,
      scientific_name: cr.best.scientific_name,
      confidence: cr.best.confidence,
      source: cr.best.source,
    }] : undefined;
    void appendTurn(chatStore, {
      id: makeTurnId(),
      role: 'assistant',
      content: turn.content,
      attachments,
    }).catch(() => { /* best effort */ });
  }

