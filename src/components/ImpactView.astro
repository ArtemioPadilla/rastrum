---
/**
 * ImpactView — "Mi impacto ecológico" page (issue #728).
 *
 * Five honest metric cards, one SECURITY DEFINER RPC round-trip
 * (`compute_user_impact`). No materialised view: with ~200 obs per
 * active user the inline aggregate is sub-100 ms.
 *
 * Each card has a tooltip that explains *how* the number is computed —
 * the Fogg "cause and effect" lever only works if the user trusts the
 * causal chain. No fake numbers; if a metric can't be computed we render
 * "—" with a `no_data_note`.
 */
import { t, getLocalizedPath, routes } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tr = t(lang);
const impact = (tr as unknown as {
  my_impact: {
    page_title: string;
    page_subtitle: string;
    sign_in_required: string;
    loading: string;
    load_error: string;
    view_link: string;
    tooltip_label: string;
    no_data: string;
    no_data_note: string;
    footer_note: string;
    transect_km: { label: string; tooltip: string };
    research_grade: { label: string; tooltip: string; no_log_note: string };
    expert_confirmed: { label: string; tooltip: string };
    in_research: { label: string; tooltip: string };
    sensitive_seen: { label: string; tooltip: string };
  };
}).my_impact;

const signInPath = getLocalizedPath(lang, routes.signIn[lang] + '/');
const obsPath = getLocalizedPath(lang, routes.profileObservations[lang] + '/');

const cards = [
  {
    key: 'transect_km',
    label: impact.transect_km.label,
    tooltip: impact.transect_km.tooltip,
    href: `${obsPath}?filter=mapped`,
    accent: 'emerald',
  },
  {
    key: 'research_grade',
    label: impact.research_grade.label,
    tooltip: `${impact.research_grade.tooltip}\n\n${impact.research_grade.no_log_note}`,
    href: `${obsPath}?filter=research_grade`,
    accent: 'teal',
  },
  {
    key: 'expert_confirmed',
    label: impact.expert_confirmed.label,
    tooltip: impact.expert_confirmed.tooltip,
    href: `${obsPath}?filter=expert_confirmed`,
    accent: 'sky',
  },
  {
    key: 'in_research',
    label: impact.in_research.label,
    tooltip: impact.in_research.tooltip,
    href: `${obsPath}?filter=in_project`,
    accent: 'indigo',
  },
  {
    key: 'sensitive_seen',
    label: impact.sensitive_seen.label,
    tooltip: impact.sensitive_seen.tooltip,
    href: `${obsPath}?filter=sensitive`,
    accent: 'amber',
  },
] as const;
---

<section
  class="rastrum-impact max-w-4xl mx-auto"
  data-lang={lang}
  data-label-loading={impact.loading}
  data-label-error={impact.load_error}
  data-label-no-data={impact.no_data}
>
  <header class="space-y-3 py-6">
    <h1 class="text-3xl font-bold tracking-tight">{impact.page_title}</h1>
    <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl">{impact.page_subtitle}</p>
  </header>

  <div
    id="impact-anon-cta"
    class="hidden rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6 text-center"
  >
    <p class="text-sm text-zinc-700 dark:text-zinc-300 mb-4">{impact.sign_in_required}</p>
    <a
      href={signInPath}
      class="inline-flex min-h-[44px] items-center rounded-lg bg-emerald-700 hover:bg-emerald-800 px-4 py-2 text-sm font-semibold text-white"
    >
      {tr.auth.sign_in}
    </a>
  </div>

  <div id="impact-error" class="hidden rounded-xl border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/30 p-4 text-sm text-rose-800 dark:text-rose-200">
    {impact.load_error}
  </div>

  <div id="impact-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {cards.map((card) => (
      <article
        class="impact-card group relative rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-5"
        data-impact-key={card.key}
      >
        <div class="flex items-start justify-between gap-2">
          <h2 class="text-sm font-medium text-zinc-600 dark:text-zinc-400">{card.label}</h2>
          <button
            type="button"
            class="impact-tooltip-btn -m-1 p-1 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded"
            aria-label={impact.tooltip_label}
            data-tooltip={card.tooltip}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke-width="2" />
              <path d="M12 16v-4M12 8h.01" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <div class="mt-3 flex items-baseline gap-2">
          <span
            class="impact-value text-3xl font-bold tabular-nums text-zinc-900 dark:text-zinc-100"
            data-impact-value={card.key}
          >—</span>
        </div>
        <a
          href={card.href}
          class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:underline focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded"
        >
          {impact.view_link}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </article>
    ))}
  </div>

  <div id="impact-loading" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {[0, 1, 2, 3, 4].map(() => (
      <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-5 animate-pulse">
        <div class="h-4 w-32 bg-zinc-200 dark:bg-zinc-800 rounded"></div>
        <div class="mt-4 h-8 w-20 bg-zinc-200 dark:bg-zinc-800 rounded"></div>
        <div class="mt-3 h-3 w-12 bg-zinc-200 dark:bg-zinc-800 rounded"></div>
      </div>
    ))}
  </div>

  <p class="mt-6 text-xs text-zinc-500 dark:text-zinc-500 max-w-2xl">{impact.footer_note}</p>

  <div
    id="impact-tooltip"
    role="tooltip"
    class="hidden fixed z-50 max-w-sm rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 p-3 text-xs leading-relaxed text-zinc-700 dark:text-zinc-200 shadow-lg whitespace-pre-line"
  ></div>
</section>

<script>
  import { getCachedUser, getSupabase } from '../lib/supabase';
  import { formatTransectKm, formatCount, isUserImpact } from '../lib/impact';

  const root = document.querySelector<HTMLElement>('.rastrum-impact');
  if (!root) {
    throw new Error('ImpactView: root not found');
  }
  const lang = (root.dataset.lang === 'es' ? 'es' : 'en') as 'en' | 'es';
  const labelNoData = root.dataset.labelNoData ?? '—';

  const anonCta = document.getElementById('impact-anon-cta');
  const errorBox = document.getElementById('impact-error');
  const grid = document.getElementById('impact-grid');
  const loading = document.getElementById('impact-loading');
  const tooltipEl = document.getElementById('impact-tooltip');

  function show(el: HTMLElement | null) {
    el?.classList.remove('hidden');
  }
  function hide(el: HTMLElement | null) {
    el?.classList.add('hidden');
  }

  function setValue(key: string, value: string) {
    const el = root!.querySelector<HTMLElement>(`[data-impact-value="${key}"]`);
    if (el) el.textContent = value;
  }

  function setAllToNoData() {
    for (const k of ['transect_km', 'research_grade', 'expert_confirmed', 'in_research', 'sensitive_seen']) {
      setValue(k, labelNoData);
    }
  }

  function positionTooltip(btn: HTMLElement) {
    if (!tooltipEl) return;
    const rect = btn.getBoundingClientRect();
    const tipRect = tooltipEl.getBoundingClientRect();
    const margin = 8;
    let left = rect.left + rect.width / 2 - tipRect.width / 2;
    let top = rect.bottom + margin;
    if (left < margin) left = margin;
    if (left + tipRect.width > window.innerWidth - margin) {
      left = window.innerWidth - margin - tipRect.width;
    }
    if (top + tipRect.height > window.innerHeight - margin) {
      top = rect.top - margin - tipRect.height;
    }
    tooltipEl.style.left = `${left}px`;
    tooltipEl.style.top = `${top}px`;
  }

  function wireTooltips() {
    if (!tooltipEl) return;
    let activeBtn: HTMLElement | null = null;

    const closeTooltip = () => {
      hide(tooltipEl);
      activeBtn = null;
    };

    root!.querySelectorAll<HTMLButtonElement>('.impact-tooltip-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const text = btn.dataset.tooltip ?? '';
        if (activeBtn === btn) {
          closeTooltip();
          return;
        }
        tooltipEl.textContent = text;
        show(tooltipEl);
        activeBtn = btn;
        positionTooltip(btn);
      });
    });

    document.addEventListener('click', (e) => {
      if (activeBtn && tooltipEl && !tooltipEl.contains(e.target as Node)) {
        closeTooltip();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeTooltip();
    });
  }

  async function init() {
    let supabase;
    try {
      supabase = getSupabase();
    } catch {
      hide(loading);
      show(anonCta);
      return;
    }

    const user = await getCachedUser();
    if (!user) {
      hide(loading);
      show(anonCta);
      return;
    }

    const { data, error } = await supabase.rpc('compute_user_impact', { p_user_id: user.id });

    if (error) {
      console.warn('compute_user_impact failed', error);
      hide(loading);
      show(grid);
      setAllToNoData();
      show(errorBox);
      wireTooltips();
      return;
    }

    if (!isUserImpact(data)) {
      hide(loading);
      show(grid);
      setAllToNoData();
      wireTooltips();
      return;
    }

    setValue('transect_km', formatTransectKm(data.transect_km, lang));
    setValue('research_grade', formatCount(data.research_grade, lang));
    setValue('expert_confirmed', formatCount(data.expert_confirmed, lang));
    setValue('in_research', formatCount(data.in_research, lang));
    setValue('sensitive_seen', formatCount(data.sensitive_seen, lang));

    hide(loading);
    show(grid);
    wireTooltips();
  }

  init().catch((err) => {
    console.warn('ImpactView init failed', err);
    hide(loading);
    show(errorBox);
  });
</script>
