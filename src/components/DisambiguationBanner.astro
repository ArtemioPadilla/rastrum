---
/**
 * DisambiguationBanner — issue #615.
 *
 * Renders an inline banner above the cascade result card when the top-2
 * candidates are nearly indistinguishable. The banner is event-driven:
 * other components (today: ObservationForm) dispatch
 * `rastrum:disambiguation-show` with the two candidates; the banner
 * fetches a diagnostic prompt (cached server-side) and renders it.
 *
 * The "Take another photo" CTA dispatches
 * `rastrum:disambiguation-retry` so the host page can re-trigger its
 * file-input flow with the same observation context.
 *
 * Skip / dismiss closes the banner without further side-effects; the
 * existing alternates list under the result card is the manual path.
 */
import { t } from '../i18n/utils';

interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;
const tr = t(lang);
const dStrings = (tr as unknown as { disambiguation?: Record<string, string> }).disambiguation ?? {};

const title              = dStrings.title              ?? 'Two close matches';
const gapExplainer       = dStrings.gap_explainer      ?? 'These two species have very similar confidence. A second photo of a key feature should resolve it.';
const takeAnother        = dStrings.take_another_photo ?? 'Take another photo';
const skip               = dStrings.skip_im_confident  ?? "I'm confident — skip";
const promptLoading      = dStrings.prompt_loading     ?? 'Looking up the best photo to take…';
const promptErrorFallback = dStrings.prompt_error_fallback ?? 'A clearer close-up of distinguishing features will help.';
---

<div
  id="disambiguation-banner"
  class="hidden mb-4 rounded-lg border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-900/30 p-4 text-sm text-amber-900 dark:text-amber-100"
  role="status"
  aria-live="polite"
  data-prompt-loading={promptLoading}
  data-prompt-fallback={promptErrorFallback}
  data-lang={lang}
>
  <div class="flex items-start gap-3">
    <span class="mt-0.5 text-base" aria-hidden="true">?</span>
    <div class="flex-1">
      <p class="font-semibold">{title}</p>
      <p class="mt-1 text-amber-800 dark:text-amber-200">{gapExplainer}</p>
      <ul id="disambiguation-candidates" class="mt-2 space-y-1 text-amber-900 dark:text-amber-100"></ul>
      <p id="disambiguation-prompt" class="mt-3 italic">{promptLoading}</p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button
          id="disambiguation-retry-btn"
          type="button"
          class="inline-flex items-center rounded-md bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700"
        >{takeAnother}</button>
        <button
          id="disambiguation-skip-btn"
          type="button"
          class="text-xs underline text-amber-900 dark:text-amber-200 hover:text-amber-700 dark:hover:text-amber-100"
        >{skip}</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { fetchDisambiguationPrompt } from '../lib/disambiguation';
  import { getKey } from '../lib/byo-keys';

  interface ShowDetail {
    top1: { scientific_name: string; confidence: number };
    top2: { scientific_name: string; confidence: number };
  }

  const banner = document.getElementById('disambiguation-banner') as HTMLElement | null;
  const candidatesList = document.getElementById('disambiguation-candidates') as HTMLElement | null;
  const promptEl = document.getElementById('disambiguation-prompt') as HTMLElement | null;
  const retryBtn = document.getElementById('disambiguation-retry-btn') as HTMLButtonElement | null;
  const skipBtn = document.getElementById('disambiguation-skip-btn') as HTMLButtonElement | null;
  if (!banner) {
    // banner not mounted — silent no-op so consuming pages stay forgiving
  } else {
    const lang = banner.dataset.lang === 'es' ? 'es' : 'en';
    const promptLoading = banner.dataset.promptLoading ?? '';
    const promptFallback = banner.dataset.promptFallback ?? '';

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }

    function renderCandidates(d: ShowDetail) {
      if (!candidatesList) return;
      const fmt = (c: { scientific_name: string; confidence: number }) => {
        const pct = Math.round((c.confidence ?? 0) * 100);
        return `<li class="flex items-baseline justify-between gap-2"><span class="italic">${escapeHtml(c.scientific_name)}</span><span class="text-xs tabular-nums">${pct}%</span></li>`;
      };
      candidatesList.innerHTML = fmt(d.top1) + fmt(d.top2);
    }

    async function show(d: ShowDetail) {
      if (!banner || !promptEl) return;
      renderCandidates(d);
      promptEl.textContent = promptLoading;
      banner.classList.remove('hidden');
      try {
        const byoAnthropic = getKey('claude_haiku', 'anthropic');
        const result = await fetchDisambiguationPrompt(d.top1.scientific_name, d.top2.scientific_name, {
          clientAnthropicKey: byoAnthropic,
        });
        const text = (lang === 'es' ? result.prompt_es : result.prompt_en) || promptFallback;
        promptEl.textContent = text;
      } catch {
        promptEl.textContent = promptFallback;
      }
    }

    function hide() {
      banner?.classList.add('hidden');
    }

    document.addEventListener('rastrum:disambiguation-show', (evt) => {
      const detail = (evt as CustomEvent<ShowDetail>).detail;
      if (!detail || !detail.top1 || !detail.top2) return;
      void show(detail);
    });
    document.addEventListener('rastrum:disambiguation-hide', () => hide());

    retryBtn?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('rastrum:disambiguation-retry'));
    });
    skipBtn?.addEventListener('click', () => hide());
  }
</script>
