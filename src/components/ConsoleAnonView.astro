---
import { t, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const tr = t(lang);
const anon = (tr as unknown as { console: { anon: Record<string, string> } }).console.anon;
const signInHref = `/${lang}/${lang === 'es' ? 'ingresar' : 'sign-in'}/`;
const publicHref = getLocalizedPath(lang, '/');
---

<div class="max-w-3xl mx-auto p-4 sm:p-6">
  <section class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6 sm:p-10 mb-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-block rounded-full bg-slate-500 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white">
        {tr.console.nav}
      </span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      {anon.title}
    </h1>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-xl">
      {anon.subtitle}
    </p>
    <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-500 max-w-xl">
      {anon.not_public_note}
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href={signInHref} class="inline-flex items-center rounded-lg bg-slate-700 hover:bg-slate-800 px-5 py-2.5 text-sm font-semibold text-white transition-colors">
        {anon.cta_signin}
      </a>
      <a href={publicHref} class="text-sm font-medium text-emerald-700 dark:text-emerald-400 hover:underline">
        {anon.cta_public}
      </a>
    </div>
  </section>

  <section class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300 mb-3">
      {anon.whats_here_heading}
    </h2>
    <ul class="space-y-3 text-sm text-zinc-700 dark:text-zinc-300">
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-0.5 text-sky-600 dark:text-sky-400">✓</span>
        <span>{anon.feature_validation}</span>
      </li>
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-0.5 text-amber-600 dark:text-amber-400">✓</span>
        <span>{anon.feature_flags}</span>
      </li>
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-0.5 text-emerald-600 dark:text-emerald-400">✓</span>
        <span>{anon.feature_audit}</span>
      </li>
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-0.5 text-rose-600 dark:text-rose-400">✓</span>
        <span>{anon.feature_anomalies}</span>
      </li>
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-0.5 text-emerald-600 dark:text-emerald-400">✓</span>
        <span>{anon.feature_users}</span>
      </li>
      <li class="flex items-start gap-3">
        <span aria-hidden="true" class="mt-0.5 text-emerald-600 dark:text-emerald-400">✓</span>
        <span>{anon.feature_health}</span>
      </li>
    </ul>
  </section>
</div>
